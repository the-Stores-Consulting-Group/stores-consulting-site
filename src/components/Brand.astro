---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<span class:list={['brand', { 'brand--compact': compact }]}>
  <img class="brand__logo" src="/assets/brand/logo.png" alt="the Stores Consulting Group — $12 billion in profit created and counting" width="1610" height="233" />
</span>

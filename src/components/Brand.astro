---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<span class:list={['brand', { 'brand--compact': compact }]}>
  <img class="brand__logo" src="/assets/brand/logo-lockup.webp" alt="the Stores Consulting Group — $12 billion in profit created and counting" width="2000" height="266" decoding="async" />
</span>

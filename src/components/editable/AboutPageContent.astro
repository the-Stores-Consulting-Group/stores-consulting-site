---
import PageIntro from '../PageIntro.astro';
import CtaBand from '../CtaBand.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { AboutPageQuery } from '../../../tina/__generated__/types';
interface Props { data: AboutPageQuery['aboutPage']; related?: any; }
const { data, related } = Astro.props;
const copy = data.copy!;
import MarkdownContent from './MarkdownContent.astro';
const people = related.people;
const groups = data.groups!;
---
<div>


  <PageIntro title={copy.title3} description={copy.description4} measure="wide" editFields={{title: tinaField(copy, 'title3'), description: tinaField(copy, 'description4')}} />
  <section class="section"><div class="shell">
    {groups.map((group) => {
      const members = people.filter((person: any) => person.tier === group.tier);
      return <section class="people-group" aria-labelledby={`group-${group.tier}`}>
        <h2 class="eyebrow" id={`group-${group.tier}`} data-tina-field={tinaField(group,'title')}>{group.title}</h2>
        <div class="people-grid">
          {members.map((person: any) => <article class="person-card" data-reveal><p class="person-card__role" data-tina-field={tinaField(person,'role')}>{person.role}</p>{person.image && <img class="person-card__portrait" src={person.image} alt={person.alt || person.name} width="240" height="240" loading="lazy" data-tina-field={tinaField(person, 'image')} />}<div class="person-card__content"><h3 data-tina-field={tinaField(person, 'name')}>{person.name}</h3><div class="prose" data-tina-field={tinaField(person,'body')}><MarkdownContent body={person.body || ''} /></div>{person.linkedin && <a class="person-card__linkedin" href={person.linkedin} target="_blank" rel="noopener noreferrer" data-tina-field={tinaField(person,'linkedin')}><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>LinkedIn</a>}</div></article>)}
        </div>
      </section>;
    })}
  </div></section>
  <CtaBand title={copy.title5} description={copy.description6} editFields={{title: tinaField(copy, 'title5'), description: tinaField(copy, 'description6')}} />


</div>

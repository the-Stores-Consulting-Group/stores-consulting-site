---
import PageIntro from '../PageIntro.astro';
import CtaBand from '../CtaBand.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { ApproachPageQuery } from '../../../tina/__generated__/types';
interface Props { data: ApproachPageQuery['approachPage']; related?: any; }
const { data } = Astro.props;
const copy = data.copy!;
import WorkstreamGrid from '../WorkstreamGrid.astro';
const foundations = data.foundations!;
---
<div>

  <PageIntro title={copy.title3} description={copy.description4} measure="wide" editFields={{title: tinaField(copy, 'title3'), description: tinaField(copy, 'description4')}} />
  <section class="section section--paper"><div class="shell"><div class="section__heading" data-reveal><p class="eyebrow" data-tina-field={tinaField(copy, 'text27')}>{copy.text27}</p><h2 data-tina-field={tinaField(copy, 'text28')}>{copy.text28}</h2><p data-tina-field={tinaField(copy, 'text29')}>{copy.text29}</p><p data-tina-field={tinaField(copy, 'text30')}>{copy.text30}</p></div><WorkstreamGrid items={foundations} /></div></section>
  <CtaBand title={copy.title5} description={copy.description6} editFields={{title: tinaField(copy, 'title5'), description: tinaField(copy, 'description6')}} />


</div>

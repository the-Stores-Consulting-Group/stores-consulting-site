---
import FieldImage from './FieldImage.astro';
import { splitCompanyName } from '../lib/company-name';
import Breadcrumbs, { type BreadcrumbItem } from './Breadcrumbs.astro';

interface Media {
  src: string;
  alt: string;
  width: number;
  height: number;
  position?: string;
}
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  compact?: boolean;
  measure?: 'standard' | 'wide';
  companyName?: boolean;
  media?: Media;
  breadcrumbs?: BreadcrumbItem[];
  editFields?: {
    eyebrow?: string;
    title?: string;
    description?: string;
    media?: string;
  };
}
const { eyebrow, title, description, compact = false, measure = 'standard', companyName = false, media, breadcrumbs, editFields } = Astro.props;
const company = companyName ? splitCompanyName(title) : null;
---

<section class:list={['page-intro', `page-intro--measure-${measure}`, { 'page-intro--compact': compact, 'page-intro--split': media }]}>
  <div class="shell page-intro__inner">
    <div class="page-intro__copy" data-reveal>
      {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
      {eyebrow && <p class="eyebrow" data-tina-field={editFields?.eyebrow}>{eyebrow}</p>}
      <h1 data-tina-field={editFields?.title}>
        {company ? (
          <>{company.before}<span class="company-name"><span class="company-name__the">{company.the}</span>{company.words.map((word) => <> <span class="company-name__initial">{word[0]}</span>{word.slice(1)}</>)}</span>{company.after}</>
        ) : title}
      </h1>
      {description && <p class="page-intro__description" data-tina-field={editFields?.description}>{description}</p>}
      <slot />
    </div>
    {media && <FieldImage {...media} eager dataReveal editField={editFields?.media} />}
  </div>
</section>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import EditorialPageContent from '../components/editable/EditorialPageContent.astro';
import { getEditorialPage } from '../lib/tina-extended-data';
export async function getStaticPaths() {
  const explicitRoutes = new Set(['/', '/about/', '/approach/', '/results/', '/clients/', '/services/', '/contact-us/', '/insights/']);
  const authors = (await getCollection('authors')).map((entry) => entry.data);
  const categories = (await getCollection('categories')).map((entry) => entry.data);
  const authorBySlug = new Map(authors.map((author) => [author.slug, author]));
  const categoryBySlug = new Map(categories.map((category) => [category.slug, category]));
  const pages = (await getCollection('legacy-pages')).filter((entry) => !explicitRoutes.has(entry.data.route)).map((entry) => ({ params: { slug: entry.data.route.replace(/^\//, '').replace(/\/$/, '') }, props: { entry, type: 'page', description: entry.data.description, published: null, author: null, categories: [], newer: null, older: null } }));
  const postEntries = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());
  const posts = postEntries.map((entry, index) => ({
    params: { slug: entry.data.route.replace(/^\//, '').replace(/\/$/, '') },
    props: {
      entry,
      type: 'post',
      description: entry.data.excerpt || entry.data.title,
      published: entry.data.publishedDate,
      author: authorBySlug.get(entry.data.author) ?? null,
      categories: entry.data.categories.map((slug) => categoryBySlug.get(slug)).filter((category) => category !== undefined),
      newer: index > 0 ? postEntries[index - 1].data : null,
      older: index < postEntries.length - 1 ? postEntries[index + 1].data : null,
    },
  }));
  return [...pages, ...posts];
}
const { entry, type } = Astro.props;
const collection = type === 'post' ? 'post' : 'legacyPage';
const path = entry.filePath!.split('/').pop()!;
const content = await getEditorialPage(collection, path);
const data = content.data;
const authors=(content.related as {authors?:Array<{slug:string;name:string;route:string}>}).authors;
const author=authors?.find(item=>item.slug===data.author);
---
<BaseLayout schemaKind={type!=='post'||data.contentType==='video'?'page':data.contentType==='report'?'report':'article'} record={data} author={author} image={data.featuredMedia||undefined} breadcrumbParent={type==='post'?'blog':'home'} seo={data.seo} title={data.title} description={data.excerpt || data.description || data.title} canonicalPath={data.route} article={type === 'post'} navSection={type === 'post' ? 'blog' : undefined}>
<TinaIsland name={collection} params={{path}} primary wrapper={{tag:"div"}}><EditorialPageContent {...content}/></TinaIsland>
<script>
  const messages: Record<string, string> = {
    success: 'Thank you. Your support request has been sent.',
    invalid: 'Please review the required fields and try again.',
    unavailable: 'The form is temporarily unavailable. Please email support@storesconsulting.com.',
  };
  const status = new URLSearchParams(location.search).get('status');
  const note = status && messages[status] ? document.querySelector('[data-enhanced-support] [data-form-feedback]') : null;
  if (note && status) note.textContent = messages[status];
  document.addEventListener('submit', async (event) => {
    const form = event.target;
    if (!(event instanceof SubmitEvent) || !(form instanceof HTMLFormElement) || !form.matches('[data-enhanced-support]') || !window.fetch) return;
    event.preventDefault();
    if (window.self !== window.top) return; // Editor previews never deliver requests.
    const feedback = form.querySelector('[data-form-feedback]');
    const submitter = event.submitter;
    if (submitter instanceof HTMLButtonElement) submitter.disabled = true;
    if (feedback) feedback.textContent = 'Sending…';
    try {
      const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } });
      if (response.status === 429) throw new Error('Too many attempts. Please wait a minute and try again.');
      const result = await response.json();
      if (!response.ok) throw new Error(result.message || messages.invalid);
      form.reset();
      if (feedback) feedback.textContent = result.message || messages.success;
    } catch (error) {
      if (feedback) feedback.textContent = error instanceof Error ? error.message : messages.unavailable;
    } finally {
      if (submitter instanceof HTMLButtonElement) submitter.disabled = false;
    }
  });
</script>
</BaseLayout>

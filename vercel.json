{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "redirects": [
    { "source": "/key-professionals/", "destination": "/about/", "permanent": true },
    { "source": "/key-professionals", "destination": "/about/", "permanent": true },
    { "source": "/industries/", "destination": "/services/", "permanent": true },
    { "source": "/industries", "destination": "/services/", "permanent": true },
    { "source": "/working-here/", "destination": "/contact-us/", "permanent": true },
    { "source": "/working-here", "destination": "/contact-us/", "permanent": true },
    { "source": "/who-is-the-stores-consulting-group/", "destination": "/about/", "permanent": true },
    { "source": "/who-is-the-stores-consulting-group", "destination": "/about/", "permanent": true },
    { "source": "/insights/", "destination": "/", "permanent": false },
    { "source": "/insights", "destination": "/", "permanent": false },
    { "source": "/tscg-blog/", "destination": "/", "permanent": false },
    { "source": "/tscg-blog", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/feed/", "destination": "/feed" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/wp-content/uploads/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
